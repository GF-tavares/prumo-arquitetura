---
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/layout.css';

import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import { getImage } from 'astro:assets';
import { photos } from '../content/assets';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Página inicial: roda a abertura e o cursor/HUD completos */
  home?: boolean;
  /** Chave da foto usada no cartão de compartilhamento */
  ogPhoto?: keyof typeof photos;
  noindex?: boolean;
}

const { title = site.title, description = site.description, home = false, ogPhoto = 'heroTunnel', noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: photos[ogPhoto].src, width: 1200, height: 630, format: 'jpg', quality: 82, fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ArchitecturalOrganization',
  name: site.legalName,
  description: site.description,
  url: new URL('/', Astro.site).href,
  email: site.email,
  foundingDate: String(site.founded),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'BR' },
};
---

<!doctype html>
<html lang={site.locale} data-home={home ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={photos[ogPhoto].alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Estado inicial: decide antes da primeira pintura se a abertura vai rodar (sem flash de conteúdo). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var q = new URLSearchParams(location.search);
          var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var c = navigator.connection;
          var save = !!(c && c.saveData);
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          var type = nav && nav.type;
          var seen = false;
          try { seen = sessionStorage.getItem('prumo:intro') === '1'; } catch (e) {}
          var forced = q.get('intro') === '1' || q.has('t');
          var ok = d.hasAttribute('data-home') && !reduced && !save && q.get('intro') !== '0' && type !== 'back_forward';
          if (ok && (!seen || type === 'reload' || forced)) d.classList.add('intro-on');
        } catch (e) {}
        // Rede de segurança: se o script principal não iniciar, mostra o conteúdo normalmente.
        setTimeout(function () {
          if (!window.__prumoBooted) d.classList.remove('js', 'intro-on');
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <slot name="chrome" />
    <div id="shell">
      <main id="main">
        <slot />
      </main>
    </div>
    <slot name="after" />
    <div class="grain" aria-hidden="true" style={`background-image:url(${base}/img/grain.png)`}></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  /* Enquanto a abertura roda: rolagem travada e página escondida atrás do overlay */
  html.intro-on,
  html.intro-on body {
    overflow: hidden;
    height: 100svh;
  }
  .intro {
    display: none;
  }
  html.intro-on .intro {
    display: block;
  }
</style>
