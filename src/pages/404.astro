---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Cursor from '../components/Cursor.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Página não encontrada | PRUMO" noindex>
  <Fragment slot="chrome">
    <Header />
    <Menu />
    <Cursor />
  </Fragment>
  <section class="nf wrap">
    <p class="t-mono nf__k">Erro 404 / Fora de prumo</p>
    <h1 class="t-serif nf__t">Este <em>espaço</em> ainda não existe.</h1>
    <a class="t-mono link-line" href={`${base}/`}>Voltar ao início</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 28px;
    background: var(--ink);
  }
  .nf__k {
    color: var(--bone-2);
  }
  .nf__t {
    font-size: clamp(3.2rem, 1rem + 9vw, 11rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    max-width: 12ch;
  }
  .nf a {
    justify-self: start;
  }
</style>
