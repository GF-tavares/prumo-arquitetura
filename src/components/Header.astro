---
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="header" data-theme="dark" data-header-root>
  <a class="brand" href={`${base}/#top`} data-cursor="ver" aria-label={`${site.name}, ${site.tagline}. Início`}>
    <svg class="brand__mark" viewBox="0 0 12 30" width="12" height="30" aria-hidden="true" focusable="false">
      <path d="M6 0v19" stroke="currentColor" stroke-width="1.2" fill="none"></path>
      <path d="M6 18.4l4 5L6 29.6 2 23.4z" fill="var(--cut)"></path>
    </svg>
    <span class="brand__word">{site.name}</span>
    <span class="brand__sub t-mono">{site.tagline}</span>
  </a>

  <p class="header__mid t-mono" aria-hidden="true">
    <span>{site.city}</span>
    <span class="header__time" data-clock>--:--</span>
  </p>

  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle data-cursor="link">
    <span class="menu-btn__label t-mono" data-menu-label>Menu</span>
    <span class="menu-btn__icon" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    color: var(--bone);
    transition: color 0.5s var(--ease-soft);
    pointer-events: none;
  }
  .header[data-theme='light'] {
    color: var(--paper-ink);
  }
  .header > * {
    pointer-events: auto;
  }
  /* escondido até a abertura terminar */
  :global(.js:not(.header-on)) .header {
    opacity: 0;
    transform: translateY(-10px);
  }
  :global(.js) .header {
    transition:
      color 0.5s var(--ease-soft),
      opacity 1s var(--ease-out),
      transform 1s var(--ease-out);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
  }
  .brand__mark {
    color: currentColor;
    flex: none;
  }
  .brand__word {
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: 0.34em;
    padding-left: 0.05em;
  }
  .brand__sub {
    color: var(--bone-3);
    padding-left: 12px;
    border-left: 1px solid currentColor;
    border-left-color: var(--line-2);
  }
  .header[data-theme='light'] .brand__sub {
    color: rgb(12 12 11 / 0.5);
    border-left-color: var(--paper-line);
  }

  .header__mid {
    display: flex;
    gap: 14px;
    color: var(--bone-3);
  }
  .header[data-theme='light'] .header__mid {
    color: rgb(12 12 11 / 0.5);
  }
  .header__time {
    font-variant-numeric: tabular-nums;
  }

  .menu-btn {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0 12px 12px;
  }
  .menu-btn__label {
    letter-spacing: 0.2em;
  }
  .menu-btn__icon {
    position: relative;
    width: 13px;
    height: 13px;
    transition: transform 0.7s var(--ease-out);
  }
  .menu-btn__icon i {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.7s var(--ease-out);
  }
  .menu-btn__icon i:nth-child(2) {
    transform: rotate(90deg);
  }
  .menu-btn:hover .menu-btn__icon {
    transform: rotate(90deg);
  }
  :global(html.menu-open) .header {
    z-index: 70;
    color: var(--bone);
  }
  :global(html.menu-open) .menu-btn__icon {
    transform: rotate(45deg);
  }
  :global(html.menu-open) .menu-btn:hover .menu-btn__icon {
    transform: rotate(135deg);
  }

  @media (max-width: 860px) {
    .header {
      grid-template-columns: 1fr auto;
    }
    .header__mid,
    .brand__sub {
      display: none;
    }
  }
</style>
