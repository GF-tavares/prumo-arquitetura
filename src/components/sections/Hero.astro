---
import { Picture } from 'astro:assets';
import { photos } from '../../content/assets';
import { site } from '../../config/site';

const hero = photos.heroTunnel;
---

<section class="hero" id="top" data-header="dark" data-chapter="Início" aria-labelledby="hero-title">
  <div class="hero__media" data-hero-media>
    <Picture
      src={hero.src}
      alt={hero.alt}
      widths={[900, 1400, 1920, 2560]}
      sizes="100vw"
      formats={['avif', 'webp']}
        fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      pictureAttributes={{ class: 'hero__picture' }}
      class="hero__img"
      style={`object-position:${hero.focus}`}
    />
    <svg class="hero__dim" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d="M0 0H100V100H0Z" data-hero-dim></path>
    </svg>
    <div class="hero__frame" data-hero-frame aria-hidden="true">
      <span class="hero__crop hero__crop--tl"></span>
      <span class="hero__crop hero__crop--tr"></span>
      <span class="hero__crop hero__crop--bl"></span>
      <span class="hero__crop hero__crop--br"></span>
      <p class="hero__fig t-mono">Fig. 01 / Estudo de luz, concreto aparente</p>
    </div>
  </div>

  <div class="hero__content wrap">
    <div class="hero__top">
      <p class="hero__kicker t-mono" data-hero-fade>
        <span>{site.name} / {site.tagline}</span>
        <span class="hero__kicker-sub">{site.city}, BR</span>
      </p>
      <p class="hero__coords t-mono t-mono--dim" data-hero-fade>{site.coords}</p>
    </div>

    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">Não desenhamos ambientes. Desenhamos o modo como o espaço se sente.</span>
      <span class="hero__lead line-mask" aria-hidden="true"><span data-hero-line>Não desenhamos ambientes.</span></span>
      <span class="hero__display t-serif" aria-hidden="true">
        <span class="line-mask"><span data-hero-line>Desenhamos</span></span>
        <span class="line-mask"><span data-hero-line>o modo como</span></span>
        <span class="line-mask"><span data-hero-line>o espaço</span></span>
        <span class="line-mask"><span data-hero-line><em>se sente.</em></span></span>
      </span>
    </h1>

    <div class="hero__foot">
      <p class="hero__note t-small" data-hero-fade>
        Casas e interiores desenhados a partir de uma pergunta: como você quer viver?
      </p>
      <a class="hero__scroll t-mono" href="#manifesto" data-hero-fade>
        <span>Role</span>
        <i aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 620px;
    overflow: clip;
    background: var(--ink);
    color: var(--bone);
    /* posição de repouso da janela iluminada (em % da tela): x, y, largura, altura */
    --ax: 55%;
    --ay: 14%;
    --aw: 32%;
    --ah: 62%;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__picture,
  .hero__img {
    width: 100%;
    height: 100%;
  }
  .hero__img {
    object-fit: cover;
    transform-origin: 34% 50%;
    will-change: transform;
  }
  .hero__dim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__dim path {
    fill: rgb(5 6 7 / 0.6);
  }
  .hero__frame {
    position: absolute;
    left: var(--ax);
    top: var(--ay);
    width: var(--aw);
    height: var(--ah);
    pointer-events: none;
    border: 1px solid rgb(236 232 223 / 0);
    opacity: 0;
  }
  .hero__crop {
    position: absolute;
    width: 11px;
    height: 11px;
  }
  .hero__crop::before,
  .hero__crop::after {
    content: '';
    position: absolute;
    background: var(--bone);
    opacity: 0.8;
  }
  .hero__crop::before {
    width: 11px;
    height: 1px;
  }
  .hero__crop::after {
    width: 1px;
    height: 11px;
  }
  .hero__crop--tl {
    left: -6px;
    top: -6px;
  }
  .hero__crop--tr {
    right: -6px;
    top: -6px;
    transform: scaleX(-1);
  }
  .hero__crop--bl {
    left: -6px;
    bottom: -6px;
    transform: scaleY(-1);
  }
  .hero__crop--br {
    right: -6px;
    bottom: -6px;
    transform: scale(-1);
  }
  .hero__fig {
    position: absolute;
    left: 0;
    top: calc(100% + 14px);
    color: var(--bone-2);
    white-space: nowrap;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    background: linear-gradient(to top, var(--ink), transparent);
    pointer-events: none;
    z-index: 0;
    opacity: var(--foot, 1);
  }
  /* o degradê da base só entra depois do corte da abertura (o corte tem que ser idêntico) */
  :global(.js) .hero {
    --foot: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: calc(var(--header-h) + 8px);
    padding-bottom: clamp(20px, 3.4vh, 40px);
    pointer-events: none;
  }
  .hero__content a {
    pointer-events: auto;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap);
    grid-row: 1;
  }
  .hero__kicker {
    display: grid;
    gap: 2px;
    color: var(--bone);
  }
  .hero__kicker-sub {
    color: var(--bone-3);
  }
  .hero__coords {
    text-align: right;
  }

  .hero__title {
    grid-row: 2;
    align-self: end;
    display: grid;
    gap: clamp(14px, 2.4vh, 28px);
    margin-bottom: clamp(20px, 3.6vh, 44px);
  }
  .hero__lead {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(0.8rem, 0.55rem + 0.75vw, 1.2rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bone);
  }
  .hero__display {
    font-size: clamp(3.1rem, 0.5rem + 7.9vw, 10.8rem);
    line-height: 0.88;
    letter-spacing: -0.032em;
    color: var(--bone);
    text-wrap: balance;
  }
  .hero__display em {
    font-style: italic;
    padding-right: 0.06em;
  }

  .hero__foot {
    grid-row: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--gap);
  }
  .hero__note {
    max-width: 30ch;
    color: var(--bone-2);
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--bone-2);
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 44px;
    background: var(--line-2);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bone);
    transform: translateY(-100%);
    animation: hero-scroll-cue 2.6s var(--ease-in-out) infinite;
  }
  @keyframes hero-scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    55%,
    100% {
      transform: translateY(100%);
    }
  }

  /* Estados iniciais (só com JS): a coreografia de entrada os libera */
  :global(.js) .hero [data-hero-line] {
    visibility: hidden;
  }
  :global(.js) .hero [data-hero-fade] {
    opacity: 0;
  }

  /* Retrato: janela iluminada centralizada no alto, texto embaixo */
  @media (max-aspect-ratio: 1/1) {
    .hero {
      --ax: 12%;
      --ay: 15%;
      --aw: 76%;
      --ah: 30%;
    }
    .hero__display {
      font-size: clamp(2.8rem, 0.5rem + 13.4vw, 6.6rem);
    }
    .hero__coords {
      display: none;
    }
    .hero__note {
      max-width: 26ch;
    }
    .hero__fig {
      display: none;
    }
  }
</style>
